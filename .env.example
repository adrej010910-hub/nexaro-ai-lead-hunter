# ============================================================
# NEXARO AI LEAD HUNTER - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your keys.
# API KEYS ARE NEVER SENT TO THE FRONTEND - server only.
# ============================================================

# --- Server ---
PORT=3000

# --- AI Provider (OpenAI-compatible: OpenAI, OpenRouter, etc.) ---
# Leave empty to use the built-in heuristic fallback analyzer.
# AIProvider will use this key for query generation + website analysis.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- Search Providers ---
# Default: duckduckgo (free, no key required - works out of the box)
# To switch to Bing/SerpAPI/Google, set SEARCH_PROVIDER and add the key.
SEARCH_PROVIDER=duckduckgo

# Bing Web Search API (Azure)
BING_API_KEY=
BING_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# SerpAPI (Google Search via API)
SERPAPI_KEY=

# Google Custom Search JSON API
GOOGLE_CX=
GOOGLE_API_KEY=

# --- Agent Owner (your identity for messages) ---
OWNER_NAME=Андрей
OWNER_TELEGRAM=https://t.me/ShadowwLi
OWNER_VK=https://vk.ru/id677188861
OWNER_EMAIL=adrej010910@gmail.com
